# ── Fact Knowledge Layer — Environment Variables ───────────────────────
# Copy this to .env and fill in your values. Never commit .env itself.

# Gemini API key (required for extraction + matching + embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model names (defaults are fine for most cases)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# Processing tunables
# MAX_CHUNK_CHARS=4000
# CANDIDATE_TOP_K=20
